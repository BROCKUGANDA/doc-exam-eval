# FRONTIER / DOC-EXAM — environment template
# Copy to .env and fill in.  Variable NAMES only in this file. NEVER commit real keys.
# The benchmark runs fully with NO keys at all:
#   python run_eval.py --offline     # regenerates documents, proves reference
#                                    # solutions, re-scores shipped transcripts
# Keys are only needed for live model trials (python run_eval.py --live).

# --- Providers (all speak the OpenAI-compatible /v1/chat/completions contract) ---
# Groq. Get a key at console.groq.com. Model ids are NEVER hardcoded here: run
# `python run_eval.py --discover` and the ids your key actually reaches get pinned
# into benchmark/results/models.lock.json with the provider-reported metadata.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini, OpenAI-compatible endpoint. Free tier works without billing;
# enable billing only if you need the paid tier.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenRouter. One key, many vendor families behind an OpenAI-compatible endpoint, and
# the only route in this build that reaches closed frontier models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama local. Start with `ollama serve`. No key required — the value below is
# ignored by Ollama but the OpenAI client schema requires a non-empty string.
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Trial budget ---
# Trials per task per model. Free tiers are request/day bounded, so the harness
# serialises per provider, backs off on 429 honouring retry-after, and journals
# every trial so --resume never re-spends a completed one.
DOCX_trials_per_task=3
DOCX_max_parallel_per_provider=1
DOCX_http_timeout_s=120

# --- Context budget guard (see benchmark/harness/context.py) ---
# Ollama defaults num_ctx to 4096 and truncates SILENTLY, keeping the tail —
# which would drop the rulebook and instruction and make a reasoning failure out
# of a truncation artifact. Minimum prompt window a model must advertise for a
# trial to run at all. Violations are recorded as SKIPPED_CONTEXT, never scored.
DOCX_min_prompt_window_tokens=16000

# --- Optional LLM judge. Deterministic graders are primary; this is off unless
# you set it. If enabled, the judge MUST be a different vendor family from the
# model under test, and DOCX_judge_repeat=2 checks the verdict does not flip.
DOCX_ENABLE_LLM_JUDGE=0
DOCX_judge_provider=
DOCX_judge_model=
DOCX_judge_repeat=2


# --- Edge layer (optional; nothing on the reproduction path uses these) ---------
# The benchmark proof runs with no proxy and no tunnel. These exist only so the Phase C
# platform can be reached from a public URL without opening inbound ports.
#
# DEMO_HOSTNAME is the judge-facing, READ-ONLY host. Per the submission rules it must open
# for anyone with the link WITHOUT requesting access, so it must NOT carry a Cloudflare
# Access policy. STUDIO_HOSTNAME is the mutating surface and is the only host that belongs
# behind Zero Trust.
DEMO_HOSTNAME=
STUDIO_HOSTNAME=

# Managed-tunnel token. Paste it into .env only -- never into docker-compose.yml, the
# repo, or the submission ZIP. Create with: cloudflared tunnel create doc-exam-edge
CLOUDFLARE_TUNNEL_TOKEN=

# ACME contact address for Caddy's automatic HTTPS. Leave blank for local-only mode.
CADDY_ACME_EMAIL=
CADDY_LOCAL_ADDR=localhost:20080
API_PORT=8010
WEB_PORT=3000
