# Patterns here are matched against paths relative to the build context root, so a bare
# `node_modules/` excludes only a top-level one and leaves frontend/node_modules in the
# context — which cost a 365 MB context transfer and a 4-minute build for an image that
# needs none of it. Every recursive exclusion is written with `**/`.
.venv/
**/venv/
.git/
.gitignore
.env
.env.*
!.env.example
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.hypothesis/
**/node_modules/
**/.next/
**/dist/
**/build/
benchmark/artifacts/
benchmark/results/runs/
benchmark/results/transcripts/
storage/
**/*.db
# docs/ is authored output for the human reviewer (the expert-review sheet), not an input to
# any test. README.md and docker-compose.yml, by contrast, are read by the `testenv` stage —
# excluding a file a COPY line names fails the build rather than merely shrinking the image.
docs/
video/
**/*.mp4
**/*.wav
**/*.srt
*.log
.DS_Store
